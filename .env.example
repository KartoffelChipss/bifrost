# Follow Readme for instructions on where to get these files.
BF_FLUXER_TOKEN="" # Also supports BF_FLUXER_TOKEN_FILE for file-based secrets management, e.g. with Docker secrets
BF_FLUXER_APP_ID=""
BF_DISCORD_TOKEN="" # Also supports BF_DISCORD_TOKEN_FILE for file-based secrets management, e.g. with Docker secrets
BF_DISCORD_APP_ID=""

BF_COMMAND_PREFIX="!b "

# Owner UserID for both Fluxer and Discord, used for Debugging commands like !b list all
BF_FLUXER_OWNER_ID=""
BF_DISCORD_OWNER_ID=""

# Temporary. Until Fluxer supports slash commands, this just helps cleans up command spam, The invoking command is still displayed in the footer w/ timestamp.
BF_DELETE_INVOCATION="false"

# Health Check
# These URLs are used to push health status updates to an uptime monitoring service. Replace with actual URLs if you want to enable this feature.
BF_DISCORD_HEALTH_URL=""
BF_FLUXER_HEALTH_URL=""

# Custom Fluxer instance
# If you custom Fluxer instance supports autodiscovery, you can set the domain here and all relevant URLs will be automatically generated. If not, you can manually set the base URL and other relevant URLs below.
#BF_FLUXER_AUTODISCOVERY_DOMAIN="chat.example.com"
# If your custom Fluxer instance does not support autodiscovery, you can manually set the base URL here. If you just set the base URL, the other relevant URLs will be automatically generated. If you want to manually set all relevant URLs, you can do so below.
#BF_FLUXER_BASE_URL="https://chat.example.com"
#BF_FLUXER_API_URL="https://chat.example.com/api"
#BF_FLUXER_MEDIA_URL="https://chat.example.com/media"
#BF_FLUXER_STATIC_CDN_URL="https://chat.example.com/static"
#BF_FLUXER_INVITE_URL="https://chat.example.com/invite"

# Supported values: 'sqlite', 'postgres'
BF_DB_DIALECT='sqlite'
# Database configuration for PostgreSQL (ignored if using SQLite)
BF_DB_NAME='bifrost'
BF_DB_USER='root'
BF_DB_PASS=''
BF_DB_HOST='localhost'
BF_DB_PORT='5432'

BF_METRICS_PORT='9091'
BF_QUEUE_TTL_MS='' # Optional: Time in milliseconds which messages that are scheduled to be relayed to Flux from Discord are kept (This is a temporary measure as sometimes flux expirences instability, this keeps a short record of stuff to relay when the bot comes online for shorter outages.)

# Web dashboard
BF_WEB_PORT='9092'
BF_WEB_PUBLIC_URL='http://localhost:9092' # Public origin the dashboard is reached at. Used to build OAuth redirect_uris and cookie settings
BF_SESSION_SECRET='' # Random secret used to sign the session cookie. Generate using `openssl rand -base64 32` or similar. Keep this secret and do not share it.

# OAuth2 client secrets for dashboard login
BF_DISCORD_CLIENT_SECRET=''
BF_FLUXER_CLIENT_SECRET=''

# Set by CI/CD — override manually if needed
GIT_COMMIT=''
REPO_URL=''
