# Follow Readme for instructions on where to get these files.
BF_FLUXER_TOKEN="" # Also supports BF_FLUXER_TOKEN_FILE for file-based secrets management, e.g. with Docker secrets
BF_FLUXER_APP_ID=""
BF_DISCORD_TOKEN="" # Also supports BF_DISCORD_TOKEN_FILE for file-based secrets management, e.g. with Docker secrets
BF_DISCORD_APP_ID=""

BF_COMMAND_PREFIX="!b "

# Owner UserID for both Fluxer and Discord, used for Debugging commands like !b list all
BF_FLUXER_OWNER_ID=""
BF_DISCORD_OWNER_ID=""

# Temporary. Until Fluxer supports slash commands, this just helps cleans up command spam, The invoking command is still displayed in the footer w/ timestamp.
BF_DELETE_INVOCATION="false"

# Health Check
# These URLs are used to push health status updates to an uptime monitoring service. Replace with actual URLs if you want to enable this feature.
BF_DISCORD_HEALTH_URL=""
BF_FLUXER_HEALTH_URL=""

# Custom Fluxer instance
# If you custom Fluxer instance supports autodiscovery, you can set the domain here and all relevant URLs will be automatically generated. If not, you can manually set the base URL and other relevant URLs below.
#BF_FLUXER_AUTODISCOVERY_DOMAIN="chat.example.com"
# If your custom Fluxer instance does not support autodiscovery, you can manually set the base URL here. If you just set the base URL, the other relevant URLs will be automatically generated. If you want to manually set all relevant URLs, you can do so below.
#BF_FLUXER_BASE_URL="https://chat.example.com"
#BF_FLUXER_API_URL="https://chat.example.com/api"
#BF_FLUXER_MEDIA_URL="https://chat.example.com/media"
#BF_FLUXER_STATIC_CDN_URL="https://chat.example.com/static"
#BF_FLUXER_INVITE_URL="https://chat.example.com/invite"

# Fluxer client cache limits. '0' or unset = unbounded. Set a number to cap how many guilds/channels are kept in memory.
BF_FLUXER_GUILD_CACHE_LIMIT='0'
BF_FLUXER_CHANNEL_CACHE_LIMIT='0'

# Supported values: 'sqlite', 'postgres'
BF_DB_DIALECT='sqlite'
# Database configuration for PostgreSQL (ignored if using SQLite)
BF_DB_NAME='bifrost'
BF_DB_USER='root'
BF_DB_PASS=''
BF_DB_HOST='localhost'
BF_DB_PORT='5432'

BF_METRICS_PORT='9091'
BF_DISABLE_MESSAGE_QUEUE='false' # Set to 'true' to disable queueing failed relays for retry
BF_QUEUE_TTL_MS='' # Optional: Time in milliseconds which messages that are scheduled to be relayed to Flux from Discord are kept (This is a temporary measure as sometimes flux expirences instability, this keeps a short record of stuff to relay when the bot comes online for shorter outages.)

# Web dashboard
BF_ENABLE_WEB_DASHBOARD='false'
BF_WEB_PORT='9092'
BF_WEB_PUBLIC_URL='http://localhost:9092' # Public origin the dashboard is reached at. Used to build OAuth redirect_uris and cookie settings
BF_SESSION_SECRET='' # Random secret used to sign the session cookie. Generate using `openssl rand -base64 32` or similar. Keep this secret and do not share it.
# Express "trust proxy" setting — controls whether X-Forwarded-* headers from a reverse proxy are trusted.
# Accepts a hop count ('1', '2', ...), 'true'/'false', an IP/CIDR, or a preset keyword ('loopback', 'uniquelocal', etc).
# Defaults to '1' (trust one hop) if unset. See https://expressjs.com/en/guide/behind-proxies.html
BF_WEB_TRUST_PROXY=''

# OAuth2 client secrets for dashboard login
BF_DISCORD_CLIENT_SECRET=''
BF_FLUXER_CLIENT_SECRET=''

# Set by CI/CD — override manually if needed
GIT_COMMIT=''
REPO_URL=''

# Fork add-ons (guild-sync, history, identity, archive). All off by default, so the fork behaves like upstream Bifröst.
# Values: true/false, 1/0, yes/no. An invalid BF_ADDONS_ENABLED stops startup. With add-ons on, any other
# invalid add-on value stops startup too; with add-ons off, it is logged as a warning and ignored.
# Add-ons need BF_DB_DIALECT='postgres'. With add-ons on and any other dialect, startup stops.
# If the add-on migrations fail, the error is logged, add-ons stay off and the relay still runs.
BF_ADDONS_ENABLED='false'
BF_ADDON_GUILD_SYNC='false'
# Guild-sync also mirrors reactions and pins on relayed messages, in bridged channels and synced threads.
# The bot reacts as itself, once per emoji. It needs Add Reactions and Read Message History on both sides,
# and permission to pin messages for pins. Custom emojis are mirrored only when guild-sync copied them.
# This runs in dry-run and apply mode, like the thread relay, and stops in read-only mode.
# History copies past Discord messages into the synced channels, posts and threads. The Discord bot needs
# Read Message History in every channel it copies. Text channels are bridged only after their history is copied.
BF_ADDON_HISTORY='false'
# Archive-thread mode for big channels. Unset = inline for every channel; set a count to send bigger
# channels to a history thread and bridge them immediately. A text or announcement channel with more
# messages than this gets its history in a locked thread named "History before <date>" and is bridged
# at once, so live chat flows while the history is copied. Voice channels always import inline.
BF_HISTORY_INLINE_MAX=''
# Milliseconds the history import waits after each copy, per webhook. Unset = 1050, which keeps under
# Fluxer's limit of 60 webhook messages a minute. Lower it only while that limit is off on your instance
# (FLUXER_DISABLE_RATE_LIMITS); with the limit on, faster sends are refused. 0 to 60000.
BF_HISTORY_SEND_INTERVAL_MS=''
# Identity needs the privileged Server Members intent enabled for the bot in the Discord developer portal.
# Without it, Discord refuses the login and the relay stops too. Identity ignores DMs that start with
# BF_COMMAND_PREFIX and answers at most 10 DMs per user per minute. For linked members it syncs mapped,
# non-moderator roles (at most 25 removals per server per hour) and the Discord server nickname to Fluxer.
BF_ADDON_IDENTITY='false'
# Archive keeps a local copy of the linked Discord servers: every message as Discord's API returns it,
# each author's name and avatars, and the files messages carry. It only reads Discord, in every mode.
# Messages and names go in the database; file bytes go in BF_ARCHIVE_DIR, stored once per SHA-256.
# Edits and deletes on Discord are kept in step; an author who opted out of history is kept without text
# or files. Channels in BF_ADDONS_EXCLUDE_CHANNELS are skipped. The bot needs Read Message History.
BF_ADDON_ARCHIVE='false'
# Absolute path of the archive's file volume. Required while BF_ADDON_ARCHIVE is on.
BF_ARCHIVE_DIR=''
# File downloads pause while the volume has less free space than this many GB. Default 20.
BF_ARCHIVE_MIN_FREE_GB=''
# Name sync puts each Discord member's current name (server nickname, else display name, else username)
# on every Fluxer copy of their messages, and follows later changes. It writes only webhook_name, through
# the bifrost.set_webhook_names function in Fluxer's database (deploy/fluxer-bridge.sql), and only for
# links in apply mode. Recent copies also get a flags-only webhook edit, so open apps update at once.
BF_ADDON_NAME_SYNC='false'
# Fluxer's Postgres, as the bifrost_bridge role that deploy/fluxer-bridge.sql creates. Required while name
# sync is on. Port defaults to 5432, database to 'fluxer', user to 'bifrost_bridge'.
BF_FLUXER_DB_HOST=''
BF_FLUXER_DB_PORT=''
BF_FLUXER_DB_NAME=''
BF_FLUXER_DB_USER=''
BF_FLUXER_DB_PASS='' # Also supports BF_FLUXER_DB_PASS_FILE
# Starting mode: 'dry-run' (default) or 'read-only'. 'apply' is not accepted here.
BF_ADDONS_MODE='dry-run'
# Apply mode writes to the destination server. It needs two switches: this one, and `sync mode apply`
# from the server owner in Discord. With this off, every plan stays a dry-run.
BF_ADDONS_ALLOW_APPLY='false'
# Discord channel or category IDs the add-ons never copy, bridge or import, separated by commas.
# A category covers every channel in it. A copy that already exists on Fluxer is left as it is.
BF_ADDONS_EXCLUDE_CHANNELS=''
# The one Discord user ID who may run `sync reset-threads`, which deletes the Fluxer copies of synced threads
# so the next cycles create them again. Unset = the command is off. Not even the server owner may run it
# unless named here. An invalid value is logged as a warning and leaves the command off.
BF_ADDONS_RESET_USER_ID=''
